                    "permit_sms": true,
                    "consultant_id": 3,
                    "categories": [
                        {
                            "name": "My Contact",
                            "consultant_id": 3,
                            "type_id": 1
                        }
                    ],
                    "notes": [
                        {
                            "id": 967,
                            "consultant_id": 3,
                            "text": "Foo bar",
